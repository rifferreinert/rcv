# Copy these names into local environment variables, user secrets, or
# Azure App Service configuration. Do not place real secrets in this file.

ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=<server>.database.windows.net;Database=<database>;Authentication=Active Directory Default;Encrypt=True;
Authentication__Jwt__SecretKey=<random-secret-at-least-32-bytes>
Authentication__Jwt__Issuer=https://<app-name>.azurewebsites.net
Authentication__Jwt__Audience=https://<app-name>.azurewebsites.net
Authentication__Jwt__ExpirationDays=7
Authentication__Google__ClientId=<google-client-id>
Authentication__Google__ClientSecret=<google-client-secret>
Authentication__Microsoft__ClientId=<microsoft-client-id>
Authentication__Microsoft__ClientSecret=<microsoft-client-secret>
Authentication__OAuth__ReturnUrl=/dashboard
